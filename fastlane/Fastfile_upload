require 'shellwords'

# ==============================================================================
# Fastfile_upload - Загрузка сборок в TestFlight
# ==============================================================================
# Этот модуль содержит lanes для загрузки IPA файлов в App Store Connect
# TestFlight для внутреннего и внешнего бета-тестирования.
#
# Основные функции:
#   - Загрузка в TestFlight для internal testers
#   - Загрузка в TestFlight для external testers
#   - Автоматическая генерация changelog из git коммитов
#   - Создание git тегов для версий
# ==============================================================================

# ==============================================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ==============================================================================

# Лимит App Store Connect на поле «What to Test» / «What's New» — сборка с
# более длинным значением отклоняется ошибкой API, а не обрезается сама
# (issue #420, п.4).
CHANGELOG_MAX_BYTES = 4000
CHANGELOG_TRUNCATION_SUFFIX = "\n… (обрезано по лимиту Apple, полная история — в git log)"

# Столько последних коммитов берём, если ни тег, ни корневой коммит не дали
# непустого changelog — требование владельца: пустого поля быть не должно
# (issue #420, п.2).
CHANGELOG_FALLBACK_COMMIT_COUNT = 20

# Получает changelog из git коммитов для поля «What to Test» в TestFlight.
#
# Порядок попыток (issue #420 — предыдущая версия тихо отдавала пустой
# changelog на раннере без тегов/с обрезанной историей):
#   1. Диапазон от последнего git-тега (`git describe --tags --abbrev=0`) до HEAD.
#   2. Диапазон от корневого коммита репозитория (`git rev-list --max-parents=0
#      HEAD`) до HEAD. Эта команда может вернуть НЕСКОЛЬКО хешей — несколько
#      корневых коммитов в истории или shallow-клон на раннере без полной
#      истории превращают её в многострочный список. Раньше это многострочное
#      значение целиком уходило в `between:` и ломало диапазон молча (в логе
#      было видно только "Collecting Git commits between <N хешей> and HEAD" и
#      дальше пустота) — теперь берём последнюю строку.
#   3. Если и это дало пусто (нет тегов, единственный коммит в истории и т.п.)
#      — последние 20 коммитов без merge, безусловно.
# Каждый шаг логирует, каким путём получен changelog — раньше источник можно
# было понять только по косвенным признакам в логе job'а.
#
# @return [String] changelog в формате списка коммитов, не длиннее лимита Apple
#
# @example
#   changelog = get_changelog_from_git
#   # => "- Fix bug with login\n- Add new feature\n"
def get_changelog_from_git
  changelog = ''
  source = nil

  # Попытка 1: диапазон от последнего тега до HEAD
  begin
    last_tag = sh('git describe --tags --abbrev=0').strip
    if last_tag.empty?
      UI.message('git describe --tags не вернул тег (пустая строка)')
    else
      changelog = changelog_from_git_commits(
        between: [last_tag, 'HEAD'],
        pretty: '- %s',
        merge_commit_filtering: 'exclude_merges'
      ).to_s
      source = "тег #{last_tag}..HEAD" unless changelog.strip.empty?
    end
  rescue StandardError => e
    UI.message("git describe --tags не нашёл тега в истории: #{e.message}")
  end

  # Попытка 2: диапазон от корневого коммита репозитория до HEAD
  if changelog.strip.empty?
    begin
      root_commits = sh('git rev-list --max-parents=0 HEAD').strip.split("\n").reject(&:empty?)
      root_commit = root_commits.last
      if root_commits.size > 1
        UI.message(
          "git rev-list --max-parents=0 HEAD вернул #{root_commits.size} корневых " \
          "коммитов (несколько корней истории или shallow-клон) — берём последний: #{root_commit}"
        )
      end
      changelog = changelog_from_git_commits(
        between: [root_commit.to_s, 'HEAD'],
        pretty: '- %s',
        merge_commit_filtering: 'exclude_merges'
      ).to_s
      source = "корневой коммит #{root_commit}..HEAD" unless changelog.strip.empty?
    rescue StandardError => e
      UI.message("Фолбэк на корневой коммит истории не сработал: #{e.message}")
    end
  end

  # Попытка 3: последние N коммитов без merge — пустого changelog быть не должно
  if changelog.strip.empty?
    begin
      changelog = sh("git log -#{CHANGELOG_FALLBACK_COMMIT_COUNT} --no-merges --pretty='- %s'").to_s
    rescue StandardError => e
      UI.message("Фолбэк на git log -#{CHANGELOG_FALLBACK_COMMIT_COUNT} тоже не сработал: #{e.message}")
      changelog = "- (не удалось собрать changelog автоматически: #{e.message})\n"
    end
    source = "последние #{CHANGELOG_FALLBACK_COMMIT_COUNT} коммитов (git log, без merge)"
  end

  UI.message("Changelog собран из: #{source}")

  truncate_changelog(changelog.to_s)
end

# Обрезает changelog под лимит App Store Connect (см. CHANGELOG_MAX_BYTES) —
# без этого upload_to_testflight падает ошибкой API вместо предупреждения.
#
# @param changelog [String]
# @return [String] значение не длиннее CHANGELOG_MAX_BYTES байт
def truncate_changelog(changelog)
  # Лимит Apple считается в БАЙТАХ, а не в символах: кириллица в UTF-8 занимает
  # два байта на символ, поэтому 4000 «символов» русского changelog — это ~8000
  # байт, и обрезка по length пропускала бы вдвое больше лимита (наблюдалось на
  # смок-тесте #420: fastlane сообщал «It currently contains 23983 bytes»).
  return changelog if changelog.bytesize <= CHANGELOG_MAX_BYTES

  UI.message("Changelog длиннее лимита Apple (#{changelog.bytesize} > #{CHANGELOG_MAX_BYTES} байт) — обрезаем")
  budget = CHANGELOG_MAX_BYTES - CHANGELOG_TRUNCATION_SUFFIX.bytesize
  # scrub: обрезка по байтам может разрубить многобайтовый символ пополам —
  # приводим строку обратно к валидному UTF-8, отбрасывая незавершённый хвост.
  truncated = changelog.byteslice(0, budget).scrub('')
  "#{truncated}#{CHANGELOG_TRUNCATION_SUFFIX}"
end

# Находит все IPA файлы в указанной директории
#
# Рекурсивно ищет все файлы с расширением .ipa в указанной директории.
# Если файлы не найдены, выбрасывает ошибку.
#
# @param search_path [String] путь для поиска IPA файлов (по умолчанию 'artifacts')
# @return [Array<String>] массив путей к IPA файлам
#
# @raise [FastlaneCore::Interface::FastlaneError] если IPA файлы не найдены
#
# @example
#   ipa_paths = find_ipa_files(search_path: 'artifacts')
#   # => ["artifacts/App_v1.0.0_b123.ipa"]
def find_ipa_files(search_path: 'artifacts')
  require 'find'

  ipa_paths = []
  # Рекурсивный поиск всех файлов с расширением .ipa
  Find.find(search_path) do |path|
    ipa_paths << path if path.end_with?('.ipa')
  end

  # Проверка наличия найденных файлов
  UI.user_error!("Не найдено ни одного IPA файла в директории: #{search_path}") if ipa_paths.empty?

  # Вывод информации о найденных файлах
  UI.success("Найдено IPA файлов: #{ipa_paths.count}")
  ipa_paths
end

# Настраивает API ключ App Store Connect
#
# Создает и возвращает объект API ключа для работы с App Store Connect API.
# Используется для загрузки сборок в TestFlight.
#
# @return [Spaceship::ConnectAPI::API] объект API ключа
#
# @example
#   api_key = setup_api_key
def setup_api_key
  app_store_connect_api_key(key_id: APPSTORE_KEY_ID,
                            issuer_id: APPSTORE_ISSUER_ID,
                            key_content: APPSTORE_KEY_CONTENT,
                            in_house: false,
                            is_key_content_base64: true)
end

